diff --git a/shell/ash.c b/shell/ash.c
index 8f4b4f088..2f07c1b69 100644
--- a/shell/ash.c
+++ b/shell/ash.c
@@ -8703,6 +8703,13 @@ test_exec(/*const char *fullname,*/ struct stat *statb)
 	if (!S_ISREG(statb->st_mode))
 		return 0; /* not a regular file */
+#if defined(KYLEOS)
+	/* KyleOS filesystems do not expose Unix permission bits.  The kernel
+	 * accepts every regular file as an exec candidate and validates its
+	 * image format in exec(), so ash must not reject a zero execute mask.
+	 */
+	return 1;
+#endif
 	if ((statb->st_mode & ANY_IX) == 0)
 		return 0; /* no one can execute */
 	if ((statb->st_mode & ANY_IX) == ANY_IX)
 		return 1; /* anyone can execute */
