 }
 
-char	pr_string_temp[128];
+char	*pr_string_temp;
+
+void PR_InitStringTemp (void)
+{
+	/* Keep the temporary buffer close enough to pr_strings for its address
+	 * difference to fit in a 32-bit QuakeC string_t. */
+	if (!pr_string_temp)
+		pr_string_temp = Hunk_AllocName (128, "pr_temp");
+}
+
+static char *PF_TempString (void)
+{
+	PR_InitStringTemp ();
+	return pr_string_temp;
+}
 
