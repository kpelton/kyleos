diff --git a/Engine/src/filesystem.c b/Engine/src/filesystem.c
index 4365d99..e35778a 100644
--- a/Engine/src/filesystem.c
+++ b/Engine/src/filesystem.c
@@ -258,6 +258,7 @@ typedef struct openFile_s{
     int cursor    ;  //lseek cursor
     int grpID     ;  //GRP id
     int used      ;  //Marker 1=used
+    uint8_t *cache;  //KyleOS: avoid repeated FAT walks for tiny GRP reads.
 } openFile_t;
 
 
@@ -337,6 +338,51 @@ int32_t kread(int32_t handle, void *buffer, int32_t leng){
     
     //File is actually in the GRP
     archive = & grpSet.archives[openFile->grpID];
+
+#ifdef KYLEOS
+    /*
+     * Build maps are parsed with thousands of tiny reads.  KyleOS FAT seeks
+     * from the beginning of a cluster chain, so doing that directly against
+     * the GRP makes level loading prohibitively slow.  Cache the currently
+     * opened GRP entry and serve its reads from memory instead.
+     */
+    if (openFile->cache == NULL)
+    {
+        int32_t fileSize = archive->filesizes[openFile->fd];
+        int32_t total = 0;
+
+        openFile->cache = malloc(fileSize);
+        if (openFile->cache != NULL)
+        {
+            lseek(archive->fileDescriptor,
+                  archive->fileOffsets[openFile->fd], SEEK_SET);
+            while (total < fileSize)
+            {
+                int32_t got = read(archive->fileDescriptor,
+                                   openFile->cache + total,
+                                   fileSize - total);
+                if (got <= 0)
+                    break;
+                total += got;
+            }
+            if (total != fileSize)
+            {
+                free(openFile->cache);
+                openFile->cache = NULL;
+            }
+        }
+    }
+
+    if (openFile->cache != NULL)
+    {
+        leng = min(leng, archive->filesizes[openFile->fd] - openFile->cursor);
+        if (leng <= 0)
+            return 0;
+        memcpy(buffer, openFile->cache + openFile->cursor, leng);
+        openFile->cursor += leng;
+        return leng;
+    }
+#endif
         
     lseek(archive->fileDescriptor,
           archive->fileOffsets[openFile->fd] + openFile->cursor,
@@ -451,6 +497,9 @@ void kclose(int32_t handle)
     if (openFile->type == SYSTEM_FILE){
         close(openFile->fd);
     }
+
+    if (openFile->cache != NULL)
+        free(openFile->cache);
 	
     memset(openFile, 0, sizeof(openFile_t));
     
